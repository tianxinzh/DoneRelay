# Generate locally: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DONERELAY_API_TOKEN=
DONERELAY_URL=http://127.0.0.1:8787
DONERELAY_STATE_FILE=./data/state.json
HOST=127.0.0.1
PORT=8787

# Telegram: message your bot first. Only this exact private chat/user is accepted.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_USER_ID=

# Experimental personal WeChat/Weixin protocol transport (not WeCom).
# Obtain credentials through the official Weixin plugin login flow; keep them local.
WEIXIN_BOT_TOKEN=
WEIXIN_USER_ID=
WEIXIN_BASE_URL=https://ilinkai.weixin.qq.com
# Usually leave empty. A private message from the bound user refreshes context.
WEIXIN_CONTEXT_TOKEN=

# Experimental official WhatsApp Cloud API transport; not personal-account QR login.
# See docs/WHATSAPP.md. All required when WHATSAPP_ACCESS_TOKEN is set.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
# Recipient international digits, without +. Send START from this number to opt in.
WHATSAPP_USER_ID=
WHATSAPP_APP_SECRET=
# Separate random string, 32+ characters, matching the Meta verification setup.
WHATSAPP_VERIFY_TOKEN=
# Explicit currently supported version from your Meta app, in vN.0 form.
WHATSAPP_GRAPH_VERSION=
WHATSAPP_WEBHOOK_PORT=8788
# Default inherits HOST. Route public HTTPS only to this separate port, never 8787.
# WHATSAPP_WEBHOOK_HOST=127.0.0.1

# Optional path to an already installed and authenticated Codex binary.
CODEX_BIN=codex
