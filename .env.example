# Generate distinct keys: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
DONERELAY_API_TOKEN=
DONERELAY_URL=http://127.0.0.1:8787
HOST=127.0.0.1
PORT=8787
DATABASE_PATH=./data/donerelay.sqlite
# Telegram: create your own bot with @BotFather. Bind a PRIVATE chat and user.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_USER_ID=
# Experimental personal WeChat, through the separate OpenClaw plugin.
# Never expose this transport key to your agent. Must differ from API_TOKEN.
DONERELAY_WECHAT_TOKEN=
WECHAT_USER_ID=
WECHAT_TARGET=
# One trusted operator per deployment. Terminal records are purged after this many days.
RETENTION_DAYS=7
