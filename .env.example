# Generate: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
DONERELAY_API_TOKEN=
DONERELAY_URL=http://127.0.0.1:8787
DONERELAY_HOST=127.0.0.1
DONERELAY_PORT=8787
# Optional. Default: ~/.donerelay (OUTSIDE the agent's workspace).
# DONERELAY_DATA_DIR=/absolute/private/path

# Telegram: create a dedicated bot using Telegram's @BotFather.
# Send it a DM; run: node --env-file=.env src/cli.mjs telegram-peers
TELEGRAM_BOT_TOKEN=
TELEGRAM_USER_ID=
TELEGRAM_CHAT_ID=

# Weixin: run "node --env-file=.env src/cli.mjs weixin-login".
# It saves an account file in DONERELAY_DATA_DIR. Never commit that file.
