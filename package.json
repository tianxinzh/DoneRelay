{
  "name": "donerelay",
  "version": "0.1.0-alpha.7",
  "description": "Slack self-DM notifications through your existing MCP connection, plus Telegram questions and approvals in one local Codex/Claude bundle; experimental WeChat support.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "donerelay": "src/cli.js"
  },
  "scripts": {
    "start": "node src/cli.js start",
    "test": "node --test",
    "check": "node --check src/cli.js && node --test",
    "check:discovery": "node scripts/check-discovery.mjs",
    "demo": "node examples/request.js",
    "check:package": "node scripts/check-package.mjs"
  },
  "files": [
    "src",
    "skills",
    "docs",
    "examples",
    "scripts/check-discovery.mjs",
    "plugin.json",
    ".claude-plugin",
    ".agents/plugins",
    "README.md",
    "README.zh-CN.md",
    "CHANGELOG.md",
    "PRIVACY.md",
    "TERMS.md",
    "SECURITY.md",
    "LICENSE",
    "llms.txt",
    ".env.example",
    "CONTRIBUTING.md",
    "scripts/render-checkout-demo.py"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tianxinzh/DoneRelay.git"
  },
  "homepage": "https://github.com/tianxinzh/DoneRelay#readme",
  "bugs": {
    "url": "https://github.com/tianxinzh/DoneRelay/issues"
  },
  "keywords": [
    "codex",
    "claude-code",
    "agent-skills",
    "ai-agents",
    "telegram",
    "telegram-bot",
    "wechat",
    "weixin",
    "human-in-the-loop",
    "remote-approvals",
    "notifications",
    "nodejs",
    "slack"
  ]
}
